{
  "name": "noxara-os",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter @companyos/web dev",
    "generate:sdk": "pnpm --filter @companyos/sdk generate",
    "check:openapi-drift": "pnpm --filter @companyos/sdk check:drift"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "eslint": "^9.17.0"
  }
}
