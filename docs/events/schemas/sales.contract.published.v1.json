{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.dev/events/sales.contract.published.v1.json",
  "title": "sales.contract.published.v1",
  "type": "object",
  "required": [
    "event_id",
    "subject",
    "org_id",
    "context",
    "aggregate",
    "event_type",
    "version",
    "occurred_at",
    "actor",
    "payload",
    "idempotency_key"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject": {
      "type": "string"
    },
    "org_id": {
      "type": "string"
    },
    "context": {
      "const": "sales"
    },
    "aggregate": {
      "const": "contract"
    },
    "event_type": {
      "const": "published"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object"
    },
    "payload": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": true
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
