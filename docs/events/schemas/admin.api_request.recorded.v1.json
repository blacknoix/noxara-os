{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companyos.dev/events/admin.api_request.recorded.v1.json",
  "title": "admin.api_request.recorded.v1",
  "type": "object",
  "required": [
    "event_id",
    "subject",
    "org_id",
    "context",
    "aggregate",
    "event_type",
    "version",
    "occurred_at",
    "actor",
    "payload",
    "idempotency_key"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "subject": {
      "type": "string",
      "pattern": "^companyos\\.org[^.]+\\.admin\\.api_request\\.recorded\\.v1$"
    },
    "org_id": { "type": "string" },
    "context": { "const": "admin" },
    "aggregate": { "const": "api_request" },
    "event_type": { "const": "recorded" },
    "version": { "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "actor": { "type": "object" },
    "payload": {
      "type": "object",
      "required": ["api_key_id", "route", "method", "status_code"],
      "additionalProperties": true
    },
    "idempotency_key": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
