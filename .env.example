# Local development only — never put production secrets here.
DATABASE_URL=postgres://companyos:companyos@127.0.0.1:5432/companyos
TEST_DATABASE_URL=postgres://companyos:companyos@127.0.0.1:5432/companyos_test
REDIS_URL=redis://127.0.0.1:6379
NATS_URL=nats://127.0.0.1:4222
CORE_SERVICE_URL=http://127.0.0.1:8081
GATEWAY_URL=http://127.0.0.1:8080
RUST_LOG=info,companyos=debug
# LOCAL-ONLY auth: unsigned JWT / X-CompanyOS-Dev-* headers. Never enable in production.
COMPANYOS_LOCAL_AUTH=1
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
TEMPORAL_ADDRESS=127.0.0.1:7233
