# Local development only — never put production secrets here.
DATABASE_URL=postgres://companyos:companyos@127.0.0.1:5432/companyos
TEST_DATABASE_URL=postgres://companyos:companyos@127.0.0.1:5432/companyos_test
REDIS_URL=redis://127.0.0.1:6379
NATS_URL=nats://127.0.0.1:4222
CORE_SERVICE_URL=http://127.0.0.1:8081
CRM_SERVICE_URL=http://127.0.0.1:8082
CRM_BIND=0.0.0.0:8082
FINANCE_SERVICE_URL=http://127.0.0.1:8083
FINANCE_BIND=0.0.0.0:8083
PROJECT_SERVICE_URL=http://127.0.0.1:8084
PROJECT_BIND=0.0.0.0:8084
HR_SERVICE_URL=http://127.0.0.1:8088
HR_BIND=0.0.0.0:8088
# Base64 32-byte AES key for HR restricted fields (local-dev sample)
# HR_FIELD_ENCRYPTION_KEY=Y29tcGFueW9zLWhyLWxvY2FsLWRldi1rZXktMzJiISE=
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8085
NOTIFICATION_BIND=0.0.0.0:8085
SEARCH_SERVICE_URL=http://127.0.0.1:8086
SEARCH_BIND=0.0.0.0:8086
ANALYTICS_SERVICE_URL=http://127.0.0.1:8087
ANALYTICS_BIND=0.0.0.0:8087
FILE_SERVICE_URL=http://127.0.0.1:8089
FILE_BIND=0.0.0.0:8089
OUTBOX_RELAY_BIND=0.0.0.0:8090
WORKFLOW_HOST_BIND=0.0.0.0:8091
AI_SERVICE_URL=http://127.0.0.1:8092
INVENTORY_SERVICE_URL=http://127.0.0.1:8093
AI_BIND=0.0.0.0:8092
# AI_API_KEY=sk-...                         # optional — mock provider when unset
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional: in-process MemoryPublisher in core/CRM/Finance/project (dev). Prefer companyos-outbox-relay.
# OUTBOX_EMBEDDED_RELAY=1
# Optional shared secret for Stripe-like finance webhook fixtures (no live keys required).
# FINANCE_WEBHOOK_SECRET=local-webhook-secret
GATEWAY_URL=http://127.0.0.1:8080
PUBLIC_APP_URL=http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
RUST_LOG=info,companyos=debug
AUTH_JWT_SECRET=local-dev-only-change-me
AUTH_COOKIE_SECURE=0
AUTH_MAIL_DIR=.tmp/mail
# LOCAL-ONLY auth bypass (headers / unsigned bearer). Default off. Never enable in production.
COMPANYOS_LOCAL_AUTH=0
# SSO admin API — still requires per-org plan flag in org_feature_flag.
COMPANYOS_SSO_ENABLED=0
# Breach check: leave HIBP off locally (fixture list). Prod: HIBP_ENABLED=1
HIBP_ENABLED=0
# OAuth (optional locally). Tests can set OAUTH_MOCK_BASE.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
FILE_BUCKET=companyos-files
FILE_LOCAL_ROOT=.tmp/files
TEMPORAL_ADDRESS=127.0.0.1:7233
