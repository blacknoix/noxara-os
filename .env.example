# Local development only — never put production secrets here.
DATABASE_URL=postgres://companyos:companyos@127.0.0.1:5432/companyos
TEST_DATABASE_URL=postgres://companyos:companyos@127.0.0.1:5432/companyos_test
REDIS_URL=redis://127.0.0.1:6379
NATS_URL=nats://127.0.0.1:4222
CORE_SERVICE_URL=http://127.0.0.1:8081
CRM_SERVICE_URL=http://127.0.0.1:8082
CRM_BIND=0.0.0.0:8082
GATEWAY_URL=http://127.0.0.1:8080
PUBLIC_APP_URL=http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
RUST_LOG=info,companyos=debug
AUTH_JWT_SECRET=local-dev-only-change-me
AUTH_COOKIE_SECURE=0
AUTH_MAIL_DIR=.tmp/mail
# LOCAL-ONLY auth bypass (headers / unsigned bearer). Default off. Never enable in production.
COMPANYOS_LOCAL_AUTH=0
# SSO admin API — still requires per-org plan flag in org_feature_flag.
COMPANYOS_SSO_ENABLED=0
# Breach check: leave HIBP off locally (fixture list). Prod: HIBP_ENABLED=1
HIBP_ENABLED=0
# OAuth (optional locally). Tests can set OAUTH_MOCK_BASE.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
TEMPORAL_ADDRESS=127.0.0.1:7233
