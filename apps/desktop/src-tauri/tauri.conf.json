{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CompanyOS",
  "version": "0.1.0",
  "identifier": "com.companyos.desktop",
  "build": {
    "frontendDist": "../",
    "devUrl": "http://127.0.0.1:1430"
  },
  "app": {
    "windows": [
      {
        "title": "CompanyOS",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["companyos"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/icon.png"
    ]
  }
}
